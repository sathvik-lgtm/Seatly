# Copy this file to .env and fill in your Razorpay TEST MODE keys.
# Get these from the Razorpay Dashboard -> Settings -> API Keys, with the
# dashboard switched to Test Mode. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional. Defaults to a local SQLite file (bookings.db) if left blank.
# Set this to a Postgres connection string (e.g. from Supabase/Neon/Railway)
# to use a hosted database instead — no code changes needed either way.
DATABASE_URL=
